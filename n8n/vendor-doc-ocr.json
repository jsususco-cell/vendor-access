    {
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Parse date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        304
      ],
      "parameters": {
        "jsCode": "// Pull a YYYY-MM-DD date out of the OpenAI Responses reply; stop if there is none.\nconst resp = $input.first().json;\nlet text = '';\nif (typeof resp.output_text === 'string' && resp.output_text) { text = resp.output_text; }\nelse if (Array.isArray(resp.output)) {\n  for (const o of resp.output) { if (o && Array.isArray(o.content)) { for (const c of o.content) { if (c && c.type === 'output_text' && c.text) text += c.text; } } }\n}\ntext = String(text).trim();\nconst m = text.match(/\\d{4}-\\d{2}-\\d{2}/);\nif (!m) { return []; }\nconst recordId = (($('Webhook').first().json.body) || {}).recordId;\nreturn [{ json: { recordId, date: m[0] } }];"
      }
    },
    {
