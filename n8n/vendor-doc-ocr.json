{
  "name": "Vendor Doc OCR — Expiration (Gemini)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vendor-doc-ocr",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "vendor-doc-ocr"
    },
    {
      "parameters": {
        "url": "=https://api.quickbase.com/v1/files/{{ $json.body.table || 'buskqh28a' }}/{{ $json.body.recordId }}/{{ $json.body.fileFid || 10 }}/1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "QB-Realm-Hostname",
              "value": "={{ $env.QB_REALM || 'byrdsonservices.quickbase.com' }}"
            },
            {
              "name": "Authorization",
              "value": "=QB-USER-TOKEN {{ $env.QB_USER_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Download file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the Gemini generateContent request from the downloaded file.\nconst item = $input.first().json;\nconst b64 = item.body;                                   // base64 file body from \"Download file\"\nconst ctRaw = (item.headers && (item.headers['content-type'] || item.headers['Content-Type'])) || 'application/pdf';\nconst media = String(ctRaw).split(';')[0].trim();        // e.g. application/pdf, image/jpeg, image/png\nconst type = (($('Webhook').first().json.body) || {}).type || 'document';\n\nconst prompt =\n  'You are extracting the EXPIRATION date from a vendor compliance document (document type: ' + type + '). ' +\n  'Find the date this document or its insurance coverage expires - look for labels like \"Expiration Date\", ' +\n  '\"Expires\", \"Valid Through\", \"Policy Expiration\", or \"Expiry\". Respond with ONLY that date in strict ' +\n  'YYYY-MM-DD format. If the document genuinely has no expiration (for example a W9 or a signed master ' +\n  'agreement), respond with exactly the word NONE. Output nothing else - no explanation.';\n\nconst geminiBody = {\n  contents: [{ parts: [ { inline_data: { mime_type: media, data: b64 } }, { text: prompt } ] }],\n  generationConfig: { maxOutputTokens: 100, temperature: 0 },\n};\nreturn [{ json: { geminiBody } }];"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $env.GEMINI_MODEL || 'gemini-2.5-flash' }}:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.geminiBody }}",
        "options": {}
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Gemini (vision)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pull a YYYY-MM-DD date out of Gemini's reply; stop if there is none.\nconst resp = $input.first().json;\nlet text = '';\ntry { text = (resp.candidates[0].content.parts || []).map((p) => p.text || '').join(''); } catch (e) {}\ntext = String(text).trim();\nconst m = text.match(/\\d{4}-\\d{2}-\\d{2}/);\nif (!m) { return []; }                                   // no expiration -> leave fid 7 blank, end here\nconst recordId = (($('Webhook').first().json.body) || {}).recordId;\nreturn [{ json: { recordId, date: m[0] } }];"
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Parse date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.quickbase.com/v1/records",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "QB-Realm-Hostname",
              "value": "={{ $env.QB_REALM || 'byrdsonservices.quickbase.com' }}"
            },
            {
              "name": "Authorization",
              "value": "=QB-USER-TOKEN {{ $env.QB_USER_TOKEN }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { to: 'buskqh28a', data: [ { '3': { value: $json.recordId }, '7': { value: $json.date } } ] } }}",
        "options": {}
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Write expiration (fid 7)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
