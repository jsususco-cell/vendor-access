    {
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        304
      ],
      "parameters": {
        "jsCode": "// Build the OpenAI Responses request from the downloaded file.\nconst item = $input.first().json;\nconst b64 = item.data;\nconst ctRaw = (item.headers && (item.headers['content-type'] || item.headers['Content-Type'])) || 'application/pdf';\nconst media = String(ctRaw).split(';')[0].trim();\nconst type = (($('Webhook').first().json.body) || {}).type || 'document';\nlet part;\nif (media.startsWith('image/')) { part = { type: 'input_image', image_url: 'data:' + media + ';base64,' + b64 }; }\nelse { part = { type: 'input_file', filename: 'document.pdf', file_data: 'data:application/pdf;base64,' + b64 }; }\nconst prompt =\n  'You are extracting the EXPIRATION date from a vendor compliance document (document type: ' + type + '). ' +\n  'Find the date this document or its insurance coverage expires - look for labels like \"Expiration Date\", ' +\n  '\"Expires\", \"Valid Through\", \"Policy Expiration\", or \"Expiry\". Respond with ONLY that date in strict ' +\n  'YYYY-MM-DD format. If the document genuinely has no expiration (for example a W9 or a signed master ' +\n  'agreement), respond with exactly the word NONE. Output nothing else - no explanation.';\nconst openaiBody = {\n  model: 'gpt-4o-mini',\n  input: [{ role: 'user', content: [ part, { type: 'input_text', text: prompt } ] }],\n};\nreturn [{ json: { openaiBody } }];"
      }
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
